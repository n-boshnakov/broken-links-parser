# GitHub token — classic PAT with public_repo scope recommended.
# Automatically mapped to github.com.
GITHUB_TOKEN=ghp_...

# Additional GitHub Enterprise hosts follow the GITHUB_<SCREAMING_HOST>_TOKEN convention.
# Dots and hyphens in the hostname are replaced with underscores.
# Example: github.tools.sap → GITHUB_TOOLS_SAP_TOKEN
GITHUB_TOOLS_SAP_TOKEN=ghp_...
# Example: github.wdf.sap.corp → GITHUB_WDF_SAP_CORP_TOKEN
# GITHUB_WDF_SAP_CORP_TOKEN=ghp_...

# AI resolution (required only with --ai flag)
AI_API_KEY=sk-...
AI_BASE_URL=https://models.answering-machine.utility.gardener.cloud.sap  # optional: LiteLLM proxy
AI_MODEL=claude-sonnet-4-6  # optional: override default model
